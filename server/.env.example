DATABASE_URL="postgresql://user:password@localhost:5432/hr_payroll?schema=public"

PORT=4000

JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Office timezone; all attendance business dates derive from this.
APP_TIMEZONE=Asia/Dhaka
# Required — the date attendance became the record of truth. Nothing is
# derived before it, so days predating the rollout never read as absences.
ATTENDANCE_GO_LIVE=2026-07-01

SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
