DATABASE_URL="postgresql://user:password@localhost:5432/hr_payroll?schema=public"

PORT=4000
# Origin allowed by CORS, and the only origin the refresh cookie is usable from.
CLIENT_ORIGIN=http://localhost:3000

JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Office timezone; all attendance business dates derive from this.
APP_TIMEZONE=Asia/Dhaka
# Required — the date attendance became the record of truth. Nothing is
# derived before it, so days predating the rollout never read as absences.
ATTENDANCE_GO_LIVE=2026-07-01

# Company identity printed on payslips and settlement statements. Optional —
# all three have defaults, unlike ATTENDANCE_GO_LIVE.
COMPANY_NAME=Byte Spate
COMPANY_ADDRESS=
# Where rendered payslip PDFs are written. Local disk; not durable on an
# ephemeral filesystem and not shared across replicas.
PAYSLIP_STORAGE_DIR=./storage/payslips

SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
